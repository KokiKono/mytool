{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Bash(lane ask:*)",
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(launchctl:*)",
      "Bash(pbcopy:*)",
      "Bash(pbpaste:*)",
      "Edit(./scripts/**)",
      "Write(./scripts/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./.githooks/**)",
      "Write(./.githooks/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.gitleaks.toml)",
      "Write(./.gitleaks.toml)",
      "Edit(./CONDITIONS.md)",
      "Write(./CONDITIONS.md)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$MYTOOL_HARNESS_DIR\"/stop-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
