{
  "permissions": {
    "deny": [
      "AskUserQuestion",
      "Bash(lane ask:*)",
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(launchctl:*)",
      "Bash(pbcopy:*)",
      "Bash(pbpaste:*)",
      "Edit(./scripts/**)",
      "Edit(./.claude/**)",
      "Edit(./.githooks/**)",
      "Edit(./.github/**)",
      "Edit(./.gitleaks.toml)",
      "Edit(./CONDITIONS.md)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./.gitignore)",
      "Edit(./rust-toolchain.toml)",
      "Edit(./rustfmt.toml)",
      "Edit(./.rustfmt.toml)",
      "Edit(./clippy.toml)",
      "Edit(./.clippy.toml)",
      "Edit(./.cargo/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$MYTOOL_RUN_DIR\"/harness/stop-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
